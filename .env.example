# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here

# 8b does not follow the system prompt reliably; 70b is the supported default.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Freezes "today" so delivery dates sit at a fixed distance and return-window
# outcomes stay stable. Remove for real time.
TRENDLY_NOW=2026-08-05T12:00:00Z
