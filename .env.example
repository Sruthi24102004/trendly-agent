# Copy to .env and fill in. Never commit .env.

# Which provider the agent uses: "gemini" (default) or "groq".
LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Groq (only needed if LLM_PROVIDER=groq) ---
GROQ_API_KEY=your_groq_api_key_here

# Model overrides. Defaults per provider:
#   gemini -> gemini-3.5-flash-lite (primary) / gemini-3.6-flash (fallback)
#   groq   -> llama-3.3-70b-versatile / llama-3.1-8b-instant
# GA strings are pinned rather than the "-latest" aliases, which hot-swap and
# may point at preview or experimental releases. Use the alias if you want
# auto-updating: PRIMARY_MODEL=gemini-flash-lite-latest
# PRIMARY_MODEL=gemini-3.5-flash-lite
# FALLBACK_MODEL=gemini-3.6-flash

# Flash-Lite defaults to "minimal" thinking, which Google warns causes
# premature tool termination in agentic flows. minimal | low | medium | high
GEMINI_THINKING_LEVEL=medium

# Freezes "today" so delivery dates sit at a fixed distance and return-window
# outcomes stay stable. Remove for real time.
TRENDLY_NOW=2026-08-05T12:00:00Z

# Model call record/replay: off | record | replay | auto
CASSETTE_MODE=off

# Minimum gap between model calls, in ms. Free Gemini tiers limit requests per
# MINUTE (15 on Flash-Lite), so scripted runs need pacing. 0 disables it.
MIN_MODEL_INTERVAL_MS=0

# Cap on honouring a provider's suggested retry delay. Beyond this the agent
# tries the fallback model instead of stalling the conversation.
MAX_RETRY_WAIT_S=12

# Operator routes (/metrics, /sessions, /dashboard, /history) show every
# conversation across all customers. Unset, they answer local requests only
# and 404 everywhere else. Set a token to reach them from a deployed host:
#   ADMIN_TOKEN=some-long-random-string
# then open /dashboard?token=some-long-random-string
ADMIN_TOKEN=

# Where turn-level telemetry is written (feeds /metrics and /dashboard).
EVENT_LOG=logs/events.jsonl
